{
	"name": "tonypark-blog",
	"main": "./worker/index.mjs",
	"compatibility_date": "2026-09-24",
	"assets": {
		"directory": "./_site",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "tonypark.dev", "custom_domain": true },
		{ "pattern": "www.tonypark.dev", "custom_domain": true }
	]
}
